<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#0D251D">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="۞ سَكِينَة"
        android:textColor="#E6D39A"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_person"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="أصحابك في دعائك"
        android:textColor="#F7F4E9"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/widget_dua"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="اللهم احفظ من نحب واكتب لهم الخير"
        android:textColor="#D9E5DC"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="7dp"
        android:background="#D8BD78"
        android:text="افتح سكينة"
        android:textColor="#071911"
        android:textStyle="bold"
        android:textSize="12sp" />
</LinearLayout>
